[global]
    monitor = 0
    follow = mouse
    width = (250, 360)
    origin = top-right
    offset = (12, 48)
    gap_size = 8
    corner_radius = 14
    frame_width = 1
    padding = 12
    horizontal_padding = 14
    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    transparency = 0
    icon_corner_radius = 8
    progress_bar_corner_radius = 4
    progress_bar_height = 8

[urgency_low]
    background = "#0c0c0c99"
    foreground = "#e8e8e8"
    frame_color = "#e8e8e815"
    timeout = 5

[urgency_normal]
    background = "#0c0c0c99"
    foreground = "#e8e8e8"
    frame_color = "#e8e8e830"
    timeout = 8

[urgency_critical]
    background = "#0c0c0c99"
    foreground = "#e8e8e8"
    frame_color = "#ff5c5c"
    timeout = 0
