{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "control-center-width": 460,
  "control-center-height": 620,
  "fit-to-screen": false,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "relative-timestamps": true,
  "text-empty": "Нет уведомлений",
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Центр управления",
      "clear-all-button": true,
      "button-text": "Очистить"
    },
    "dnd": {
      "text": "Не беспокоить"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "  Wi-Fi",
          "command": "sh -c 'swaync-client -cp -sw; ~/.config/sway/wifi-menu.sh'"
        },
        {
          "label": "  Bluetooth",
          "command": "sh -c 'swaync-client -cp -sw; ~/.config/sway/bt-menu.sh'"
        },
        {
          "label": "  VPN",
          "command": "sh -c 'swaync-client -cp -sw; ~/.config/sway/vpn-menu.sh'"
        },
        {
          "label": "  Микрофон",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1'",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true'"
        },
        {
          "label": "  Блок",
          "command": "sh -c 'swaync-client -cp -sw; ~/.config/sway/lock.sh'"
        },
        {
          "label": "  Выкл",
          "command": "sh -c 'swaync-client -cp -sw; ~/.config/rofi/powermenu.sh'"
        }
      ]
    },
    "volume": {
      "label": "",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false
    },
    "backlight": {
      "label": "",
      "device": "intel_backlight"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 12,
      "autohide": true,
      "show-album-art": "when-available"
    }
  }
}