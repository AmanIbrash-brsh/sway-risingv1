* {
    base: #0c0c0c; surface: #1c1c1c; text: #e8e8e8; mauve: #e8e8e8; subtext: #8c8c8c;
    background-color: transparent;
    text-color: @text;
    font: "JetBrains Mono 12";
}
window {
        background-color: rgba(12,12,12,0.60);
    border: 1px; border-color: rgba(232,232,232,0.14); border-radius: 20px;
    padding: 18px;
    width: 600px;
}
mainbox { spacing: 10px; }
inputbar {
    background-color: rgba(255,255,255,0.07); border-radius: 14px; padding: 12px 16px; spacing: 8px;
    children: [ prompt, entry ];
}
prompt { text-color: @mauve; }
entry { placeholder: "Search..."; placeholder-color: @subtext; }
listview { lines: 8; scrollbar: false; spacing: 4px; fixed-height: true; }
element { padding: 9px 14px; border-radius: 14px; spacing: 10px; }
element selected { background-color: rgba(232,232,232,0.92); text-color: #0c0c0c; }
element-icon { size: 1.4em; }
