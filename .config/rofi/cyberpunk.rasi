* {
    background-color: #05050a;
    text-color:       #fcee09;
    border-color:     #fcee09;
    font:             "monospace 11";
}

window {
    border:           2px;
    padding:          15px;
    width:            500px;
}

element selected {
    background-color: #fcee09;
    text-color:       #000000;
}

entry {
    placeholder:      "OVERRIDE_SYSTEM...";
    placeholder-color:#444444;
    text-color:       #ff003c;
}
